# Payments are disabled unless configured explicitly. Local demonstration only:
# PAYMENT_MODE=sandbox (uses a separate database and never calls a bank)
PAYMENT_MODE=disabled
HOST=127.0.0.1
PORT=3001
# DATABASE_PATH=./data/fapix.sqlite

