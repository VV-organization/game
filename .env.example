# Payments stay disabled until an actual provider is configured. No payment simulator.
PAYMENT_MODE=disabled
HOST=127.0.0.1
PORT=3001
# DATABASE_PATH=./data/fapix.sqlite
# Docker Compose overrides HOST/PORT; persistent database path inside the container:
# DATABASE_PATH=/app/data/fapix.sqlite

# For a real deployment, set NODE_ENV=production and provide your own HTTPS origin.
# PUBLIC_URL=https://racing.example
# PAYMENT_MODE=arco
# ARCO_PAY_SHOP_ID=
# ARCO_PAY_API_KEY=
# ARCO_PAY_BEARER_TOKEN=
# ARCO_PAY_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
# ARCO_PAY_API_URL=https://api.clickit.team/api/v1
# ARCO_PAY_PAYMENT_ORIGIN=https://payment.paidlayer.com
