{
  "name": "fapix-racing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start": "NODE_ENV=production tsx server/index.ts",
    "format": "prettier --write src server vite.config.ts",
    "format:check": "prettier --check src server vite.config.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
